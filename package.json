{
  "name": "maison-goya",
  "version": "1.0.0",
  "private": true,
  "description": "Maison Goya — bilingual luxury commerce and scrollytelling frontend",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/commerce.test.ts tests/i18n.test.ts tests/backend.test.ts tests/international.test.ts tests/translation-coverage.test.ts",
    "setup:demo": "node scripts/setup-demo.cjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:assets": "node scripts/check-assets.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "check:release": "npm run check:assets && npm run check && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@neondatabase/serverless": "1.2.0",
    "@netlify/blobs": "11.1.4",
    "gsap": "^3.13.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "3.6.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}

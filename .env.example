# Leave DATABASE_URL empty for the local file-backed demo.
# On Netlify, set the pooled PostgreSQL connection string from Neon.
DATABASE_URL=
DEMO_LOCAL=true
# Do not set DEMO_LOCAL on Netlify. It is only for running locally.
APP_URL=http://localhost:3000

# Set unique credentials before deploying. Local-only defaults:
# admin@goya.demo / MaisonDemo2026!
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Generate using: node scripts/setup-demo.cjs
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:demo@example.com
